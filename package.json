{
  "name": "banca-dati-merito-mcp",
  "version": "0.1.2",
  "description": "Server MCP non ufficiale per la Banca Dati di Merito del Ministero della Giustizia (bdp.giustizia.it): ricerca e lettura di provvedimenti e abstract con la propria sessione CIE/SPID/CNS.",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "banca-dati-di-merito",
    "giurisprudenza",
    "giustizia",
    "italia",
    "legal"
  ],
  "license": "Apache-2.0",
  "author": "Andrea Dorizza",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/andreadorizza/banca-dati-merito-mcp.git"
  },
  "homepage": "https://github.com/andreadorizza/banca-dati-merito-mcp#readme",
  "bugs": "https://github.com/andreadorizza/banca-dati-merito-mcp/issues",
  "type": "module",
  "bin": {
    "banca-dati-merito-mcp": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
